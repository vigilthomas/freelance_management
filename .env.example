# Copy to .env and edit before running scripts/setup.sh

# Domain or subdomain pointing at this server (A/AAAA record). Caddy gets the HTTPS certificate automatically.
DOMAIN=work.example.com

# Your email: becomes the PocketBase admin (superuser) and the app login.
ADMIN_EMAIL=you@example.com

# Space-separated IPs/CIDRs allowed to open the PocketBase admin at https://DOMAIN/_/
# 127.0.0.1/32 means "only via SSH tunnel". Add your home IP if you want direct access.
ADMIN_IPS=127.0.0.1/32
